{
  "name": "nubile",
  "private": true,
  "type": "module",
  "workspaces": ["frontend"],
  "scripts": {
    "dev": "npm --workspace frontend run dev",
    "build": "npm --workspace frontend run build",
    "lint": "npm --workspace frontend run lint",
    "test:frontend": "npm --workspace frontend run test",
    "verify:deployment": "python scripts/verify_deployment.py",
    "verify": "npm run lint && npm run test:frontend && npm run build && npm run verify:deployment",
    "deploy": "genlayer deploy"
  },
  "devDependencies": {
    "genlayer-js": "^1.1.8"
  }
}
